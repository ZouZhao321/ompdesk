# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# gitnexus index
.gitnexus/

# git worktrees
.worktrees/

# 本地临时产物（.tmp/<任务>/ 自包含，见 AGENTS.md）
.tmp/

# 改动与删除前的自动备份（omp 扩展 backup-guard 写入）
.backups/

# typescript
*.tsbuildinfo
next-env.d.ts
.factory
src-tauri/target/
src-tauri/gen/
src-tauri/resources/
src-tauri/server/.remember/
