{
  "name": "ompdesk",
  "version": "0.5.1",
  "description": "Browser workspace for the omp (oh-my-pi) coding agent CLI",
  "homepage": "https://github.com/ZouZhao321/ompdesk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZouZhao321/ompdesk.git"
  },
  "bugs": {
    "url": "https://github.com/ZouZhao321/ompdesk/issues"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "coding-agent",
    "web-ui"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.14"
  },
  "bin": {
    "ompdesk": "bin/ompdesk.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "bun --bun next dev --webpack -H 127.0.0.1 -p 30141",
    "build": "bun --bun next build --webpack",
    "start": "bun --bun next start -H 127.0.0.1 -p 30141",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke:dev": "bun scripts/smoke-dev.mjs",
    "scratch": "bun scripts/scratch.mjs",
    "tracker:claim": "bun scripts/tracker-sync.mjs claim",
    "tracker:link": "bun scripts/tracker-sync.mjs link",
    "tracker:done": "bun scripts/tracker-sync.mjs done",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public"
  },
  "dependencies": {
    "@oh-my-pi/pi-agent-core": "~18.10.4",
    "@oh-my-pi/pi-ai": "~18.10.4",
    "@oh-my-pi/pi-coding-agent": "~18.10.4",
    "@oh-my-pi/pi-tui": "~18.10.4",
    "@oh-my-pi/pi-utils": "~18.10.4",
    "js-yaml": "^5.5.0",
    "next": "16.2.12",
    "proper-lockfile": "4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-frontmatter": "^5.0.0",
    "undici": "8.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.23.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.9",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.13.0",
    "mermaid": "^11.17.2",
    "postcss": "^8.5.31",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
