{
  "name": "ompdesk",
  "version": "1.0.27",
  "description": "Independent browser workspace fork of pi-web for the omp (oh-my-pi) coding agent CLI",
  "homepage": "https://github.com/ZouZhao321/ompdesk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZouZhao321/ompdesk.git"
  },
  "bugs": {
    "url": "https://github.com/ZouZhao321/ompdesk/issues"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "coding-agent",
    "web-ui"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.2"
  },
  "bin": {
    "ompdesk": "bin/ompdesk.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "bun --bun next dev --webpack -H 127.0.0.1 -p 30141",
    "build": "bun --bun next build --webpack",
    "start": "bun --bun next start -H 127.0.0.1 -p 30141",
    "lint": "eslint .",
    "format": "bun run format:code && bun run format:css && bun run format:json",
    "format:code": "prettier --config prettier/code.config.json --write \"**/*.{ts,tsx,mjs,js,cjs}\"",
    "format:css": "prettier --config prettier/css.config.json --write \"**/*.css\"",
    "format:json": "prettier --config prettier/json.config.json --write \"**/*.json\"",
    "format:check": "prettier --config prettier/code.config.json --check \"**/*.{ts,tsx,mjs,js,cjs}\" && prettier --config prettier/css.config.json --check \"**/*.css\" && prettier --config prettier/json.config.json --check \"**/*.json\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "coverage:exports": "bun scripts/coverage-gate.mjs --exports-only",
    "coverage:gate": "bun scripts/coverage-gate.mjs",
    "coverage:baseline": "bun scripts/coverage-gate.mjs --write-baseline",
    "check": "bun run typecheck && bun run lint",
    "ci": "bun run format && bun run typecheck && bun run coverage:exports && bun run coverage:gate && bun run build && bun run smoke:dev",
    "verify": "bun run ci",
    "verify:push": "bun scripts/verify-push.mjs",
    "lint:changed": "bun scripts/lint-changed.mjs",
    "check:titles": "bun scripts/check-pr-titles.mjs",
    "verify:package": "bun scripts/verify-package.mjs",
    "smoke:dev": "bun scripts/smoke-dev.mjs",
    "scratch": "bun scripts/scratch.mjs",
    "queue": "bun scripts/pr-queue.ts",
    "queue:sync": "bun scripts/pr-queue-sync.ts",
    "release": "bun scripts/release.ts",
    "release:finish": "bun scripts/release.ts finish"
  },
  "dependencies": {
    "@oh-my-pi/pi-agent-core": "~18.10.4",
    "@oh-my-pi/pi-ai": "~18.10.4",
    "@oh-my-pi/pi-catalog": "~18.10.4",
    "@oh-my-pi/pi-coding-agent": "~18.10.4",
    "@oh-my-pi/pi-tui": "~18.10.4",
    "@oh-my-pi/pi-utils": "~18.10.4",
    "@opentelemetry/api": "^1.9.1",
    "js-yaml": "^5.5.0",
    "next": "16.4.4",
    "proper-lockfile": "4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-virtuoso": "^4.18.20",
    "remark-frontmatter": "^5.0.0",
    "undici": "8.12.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@lobehub/icons": "6.15.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.9",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "10.1.8",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.13.0",
    "mermaid": "12.2.0",
    "postcss": "^8.5.31",
    "prettier": "3.6.2",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
